{
  "name": "zcode-manage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" run build",
    "dev": "pnpm run dev:env && pnpm run dev:apps",
    "dev:env": "node scripts/dev-env.mjs",
    "dev:apps": "node --env-file=deploy/dev/apps.env scripts/dev-apps.mjs",
    "dev:console": "pnpm --filter @zm/console dev",
    "stack:up": "docker compose --env-file deploy/dev/stack.env -f deploy/dev/compose.yaml up -d --wait --remove-orphans",
    "stack:down": "docker compose --env-file deploy/dev/stack.env -f deploy/dev/compose.yaml down",
    "stack:ps": "docker compose --env-file deploy/dev/stack.env -f deploy/dev/compose.yaml ps",
    "step1:exit": "bash scripts/step1-exit.sh",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json && pnpm --filter @zm/console typecheck",
    "verify:pre-push": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
