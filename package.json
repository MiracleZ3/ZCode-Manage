{
  "name": "zcode-manage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" run build",
    "dev": "concurrently -k -n api,gateway -c blue,green \"pnpm --filter @zm/manage-api dev\" \"pnpm --filter @zm/model-gateway dev\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "verify:pre-push": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
