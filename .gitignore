# 依赖与构建产物
node_modules/
dist/
# 类型检查（tsc -b）的输出目录；dist/ 只放可运行的打包结果，两者互不覆盖
dist-tsc/
coverage/
*.tsbuildinfo
.turbo/
/out/

# 环境变量与本地配置（示例文件除外）
.env
.env.*
!.env.example
!.env.*.example
# 本机开发用的应用环境，由 scripts/dev-env.mjs 随机生成
deploy/dev/apps.env

# 本地数据、临时文件与离线包
/data/
/tmp/
/releases/
/offline/
*.tar
*.tar.gz

# 密钥与证书（许可证签名、TLS 等，均不入库）
*.pem
*.key
*.p12
*.pfx
*.keystore

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# husky 生成的 hook 脚本目录；受版本控制的是 .husky/pre-push 本身
.husky/_/
