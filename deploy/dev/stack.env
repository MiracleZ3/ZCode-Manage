# 开发栈的默认取值。全部是本机开发用的假值，可以按需覆盖，不要放真实凭据。

# 留空或在命令行设为 docker.io 即可改用 Docker Hub
ZM_IMAGE_REGISTRY=docker.m.daocloud.io

# PostgreSQL
ZM_DEV_POSTGRES_TAG=16-alpine
ZM_DEV_DB_PORT=5432
ZM_DEV_DB_USER=zm
ZM_DEV_DB_PASSWORD=zm-dev-password
ZM_DEV_DB_NAME=zm

# Keycloak
ZM_DEV_KEYCLOAK_TAG=26.2
ZM_DEV_KEYCLOAK_PORT=8180
ZM_DEV_KEYCLOAK_ADMIN=admin
ZM_DEV_KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
